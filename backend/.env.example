NODE_ENV=development
PORT=4000
# Local Docker database; do not reuse these development credentials in production.
DATABASE_URL=postgresql://wisey:wisey_local_only@localhost:54329/wisey_tutors?schema=public
# Generate a unique secret, for example: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_ACCESS_SECRET=replace-with-a-unique-secret-at-least-32-characters
AUTH_ISSUER=wisey-tutors-api
AUTH_AUDIENCE=wisey-tutors-admin
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=14
AUTH_SESSION_MAX_DAYS=30
AUTH_COOKIE_SAME_SITE=lax
# Set both values to bootstrap the first owner with `npm run db:seed`.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
# Enable only behind a trusted single reverse proxy; otherwise leave false.
TRUST_PROXY=false
LOG_LEVEL=info


